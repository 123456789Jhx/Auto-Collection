NODE_ENV=development
APP_ENV=development

WEB_BIND_HOST=0.0.0.0
WEB_PORT=3022
API_PORT=3012

DATABASE_URL=postgres://postgres:<password>@localhost:5432/auto_collection
REDIS_URL=redis://:<password>@localhost:6379

JWT_SECRET=change-me-local-jwt
COOKIE_SECRET=change-me-local-cookie
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_TTL_SECONDS=86400

LOG_LEVEL=info

# Optional in development. Leave empty to avoid embedding a registration secret in a local APK.
# MOBILE_REGISTRATION_SECRET=

# 指向当前项目本地 API
VITE_API_BASE_URL_DEV=http://localhost:3012/api/v1
VITE_API_BASE_URL=http://localhost:3012/api/v1
VITE_API_PROXY_TARGET=http://localhost:3012
