{
  "name": "auto-collection",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun --filter @app/web dev",
    "dev:api": "bun --filter @app/api dev",
    "build": "bun run build:web && bun run build:api",
    "build:web": "bun --filter @app/web build",
    "build:api": "bun --filter @app/api build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "bun test",
    "db:generate": "bun --filter @pkg/db db:generate",
    "db:migrate": "bun --filter @pkg/db db:migrate",
    "db:push": "bun --filter @pkg/db db:push",
    "db:studio": "bun --filter @pkg/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/bun": "^1.3.3",
    "eslint": "^9.16.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.17.0"
  }
}
